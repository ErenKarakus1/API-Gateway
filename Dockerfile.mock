FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/mock-service ./cmd/mock-service

FROM alpine:3.22

WORKDIR /app

RUN apk add --no-cache wget

COPY --from=build /bin/mock-service /app/mock-service

EXPOSE 9001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:9001/health || exit 1

ENTRYPOINT ["/app/mock-service"]
